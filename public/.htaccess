# ==============================================================================
# FaceTube - Apache 2.4 Web Server Configuration (Hostinger / cPanel)
# ==============================================================================

# 1. Block direct browser access to sensitive configuration files & database dumps
<FilesMatch "^\.env|.*\.sql$|composer\.(json|lock)$|\.git.*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Options
Options -Indexes

# 3. Charset
AddDefaultCharset UTF-8

# 4. Uploads media requests are served directly from the local uploads/ directory
# (Redirect removed because uploads are stored and served locally on facetube.online)

# 5. Pass Authorization headers through to PHP-FPM / FastCGI (Hostinger / cPanel)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase X-Authorization "(.*)" HTTP_X_AUTHORIZATION=$1
</IfModule>

