# ==============================================================================
# FaceTube - Apache Configuration for Hostinger PHP API (api.facetube.online)
# ==============================================================================

# 1. Disable directory browsing for API security
Options -Indexes

# 2. Block direct browser access to sensitive environment & configuration files
<FilesMatch "^\.env|.*\.sql$|composer\.(json|lock)$|\.git.*|.*_credentials\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Default charset
AddDefaultCharset UTF-8

# 4. Pass Authorization & X-Authorization headers to PHP-FPM / FastCGI (Hostinger / cPanel)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase X-Authorization "(.*)" HTTP_X_AUTHORIZATION=$1
</IfModule>
